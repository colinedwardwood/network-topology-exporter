        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Topology Changes",
      "targets": [
        {
          "expr": "sum(increase(network_topology_change_total{tester_id=\"$tester_id\"}[$__rate_interval])) by (change_kind, discovery_proto)",
          "legendFormat": "{{change_kind}} ({{discovery_proto}})",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Exporter Health: Conflicts & Drops",
      "targets": [
        {
          "expr": "sum(rate(network_topology_conflict_total{tester_id=\"$tester_id\"}[$__rate_interval])) by (conflict_type)",
          "legendFormat": "Conflict: {{conflict_type}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(network_topology_snapshot_drops_total{tester_id=\"$tester_id\"}[$__rate_interval])) by (reason)",
          "legendFormat": "Drop: {{reason}}",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    }
