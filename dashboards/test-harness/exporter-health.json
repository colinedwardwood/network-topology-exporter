            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(network_topology_discovery_devices_total{tester_id=\"$tester_id\"}) by (status, reason)",
          "legendFormat": "{{status}} ({{reason}})",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
