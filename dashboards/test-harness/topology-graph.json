{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "edges": {
          "mainStatUnit": "short",
          "secondaryStatUnit": "short"
        },
        "layoutAlgorithm": "layered",
        "nodes": {
          "arcs": [],
          "mainStatUnit": "short",
          "nodeRadius": 40,
          "secondaryStatUnit": "short"
        },
        "zoomMode": "cooperative"
      },
      "pluginVersion": "13.1.0-25668120414",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(network_topology_device_info{tester_id=\"$tester_id\"}, \"id\", \"$1\", \"device_id\", \"(.*)\"), \"mainStat\", \"$1\", \"device_id\", \"(.*)\"), \"title\", \"$1\", \"vendor\", \"(.*)\"), \"subTitle\", \"$1\", \"site\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "refId": "Nodes"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(network_topology_edge_info{tester_id=\"$tester_id\"}, \"id\", \"$1\", \"src_port\", \"(.*)\"), \"source\", \"$1\", \"src_device\", \"(.*)\"), \"target\", \"$1\", \"dst_device\", \"(.*)\"), \"mainStat\", \"$1\", \"discovery_proto\", \"(.*)\"), \"secondaryStat\", \"$1\", \"link_kind\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "refId": "Edges"
        }
      ],
      "title": "Network Topology Graph",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #Edges": true,
              "Value #Nodes": true,
              "__name__": true,
              "device_id": true,
              "direction": true,
              "discovery_proto": true,
              "dst_device": true,
              "dst_port": true,
              "env": true,
              "instance": true,
              "job": true,
              "link_kind": true,
              "model": true,
              "os_version": true,
              "site": true,
              "src_device": true,
              "src_port": true,
              "tester_id": true,
              "vendor": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "type": "nodeGraph"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "pluginVersion": "13.1.0-25668120414",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "network_topology_edge_info{tester_id=\"$tester_id\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Edge Detail Table",
      "type": "table"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "test-harness",
    "topology"
  ],
  "templating": {
    "list": [
