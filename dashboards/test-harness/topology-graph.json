        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(network_topology_device_info, tester_id)",
        "hide": 0,
        "includeAll": false,
        "label": "Tester ID",
        "multi": false,
        "name": "tester_id",
        "options": [],
        "query": {
          "query": "label_values(network_topology_device_info, tester_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "regexApplyTo": "value",
        "skipUrlSync": false,
