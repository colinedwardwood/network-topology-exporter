{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Running Components",
      "targets": [
        {
          "expr": "sum(alloy_component_controller_running_components{tester_id=\"$tester_id\"})",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "title": "Alloy Health",
      "targets": [
        {
          "expr": "up{job=\"alloy\", tester_id=\"$tester_id\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              },
              "type": "value"
            }
          ]
        }
      },
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "content": "**Version:** {{alloy_build_info.version}}\n**Revision:** {{alloy_build_info.revision}}",
        "mode": "markdown"
      },
      "title": "Alloy Build Info",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10 },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 4,
      "title": "CPU Usage",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"alloy\", tester_id=\"$tester_id\"}[$__rate_interval])",
          "legendFormat": "Alloy CPU",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisPlacement": "auto", "drawStyle": "line", "fillOpacity": 10 },
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 5,
      "title": "Memory Usage",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"alloy\", tester_id=\"$tester_id\"}",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "title": "Remote Write Throughput",
      "targets": [
        {
          "expr": "sum(rate(prometheus_remote_write_sent_samples_total{tester_id=\"$tester_id\"}[$__rate_interval])) by (remote_name)",
          "legendFormat": "Sent: {{remote_name}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(prometheus_remote_write_dropped_samples_total{tester_id=\"$tester_id\"}[$__rate_interval])) by (remote_name)",
          "legendFormat": "Dropped: {{remote_name}}",
          "refId": "B"
        },
        {
          "expr": "sum(rate(prometheus_remote_write_failed_samples_total{tester_id=\"$tester_id\"}[$__rate_interval])) by (remote_name)",
          "legendFormat": "Failed: {{remote_name}}",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["test-harness", "alloy", "health"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": null,
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(network_topology_device_info, tester_id)",
        "hide": 0,
        "includeAll": false,
        "label": "Tester ID",
        "multi": false,
        "name": "tester_id",
        "options": [],
        "query": {
          "query": "label_values(network_topology_device_info, tester_id)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Alloy Health (Enhanced)",
  "uid": "alloy-health-v2",
  "version": 1
}
