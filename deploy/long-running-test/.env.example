# Long-running lab — Alloy credentials
#
# Copy this file to `.env` (gitignored) and fill in real values.
# docker compose --env-file .env up -d   will pick these up.
#
# Token: a single Grafana Cloud Access Policy token with write scopes for
# metrics, logs, and traces (https://grafana.com/docs/grafana-cloud/account-management/authentication-and-permissions/access-policies/).
GRAFANA_CLOUD_TOKEN=

# Stack user IDs (see Connections > Data sources in your Grafana stack)
GRAFANA_PROM_USER=
GRAFANA_LOKI_USER=
GRAFANA_TEMPO_USER=

# SNMP community string for the lab targets
SNMP_COMMUNITY=public
